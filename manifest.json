{
  "manifest_version": 3,
  "name": "WhatsWeb Blocker",
  "version": "1.0",
  "description": "Hide messages from specific users and filter media on WhatsApp Web.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WhatsWeb Blocker"
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
